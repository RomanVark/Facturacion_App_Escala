<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="ni.edu.uam.facturacionapp.Controller.MainController" prefWidth="1080" prefHeight="720" stylesheets="@styles.css">
 <left><VBox styleClass="sidebar" spacing="16" prefWidth="230">
  <Label text="FacturaciónAPP" styleClass="brand"/><Label text="GESTIÓN DE CATÁLOGOS" styleClass="side-subtitle"/>
  <Separator/><Label text="ESPACIO DE TRABAJO" styleClass="side-subtitle"/>
  <Button text="Categorías" onAction="#categorias" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="Productos" onAction="#productos" styleClass="nav-button" maxWidth="Infinity"/>
  <Button text="Clientes" onAction="#clientes" styleClass="nav-button" maxWidth="Infinity"/>
  <Region VBox.vgrow="ALWAYS"/><Label text="Organiza. Consulta. Actualiza." styleClass="side-subtitle" wrapText="true"/>
 </VBox></left>
 <center><VBox styleClass="page" spacing="24">
  <Label text="VISTA GENERAL" styleClass="eyebrow"/><Label text="Tu información, en un lugar" styleClass="title"/>
  <Label text="Abre un catálogo para consultar, crear o actualizar tus registros." styleClass="muted" wrapText="true"/>
  <HBox spacing="16">
   <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS"><Label text="Categorías" styleClass="card-title"/><Label fx:id="totalCategorias" text="—" styleClass="metric"/><Label text="Grupos de productos" styleClass="muted"/><Button text="Abrir categorías →" onAction="#categorias"/></VBox>
   <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS"><Label text="Productos" styleClass="card-title"/><Label fx:id="totalProductos" text="—" styleClass="metric"/><Label text="Registros del catálogo" styleClass="muted"/><Button text="Abrir productos →" onAction="#productos"/></VBox>
   <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS"><Label text="Clientes" styleClass="card-title"/><Label fx:id="totalClientes" text="—" styleClass="metric"/><Label text="Contactos registrados" styleClass="muted"/><Button text="Abrir clientes →" onAction="#clientes"/></VBox>
  </HBox>
  <VBox styleClass="card" spacing="12"><Label text="Inventario de productos" styleClass="card-title"/><Label fx:id="unidades" text="Cargando…"/><Label fx:id="activos" text="" styleClass="muted"/></VBox>
  <Region VBox.vgrow="ALWAYS"/>
  <HBox spacing="12"><Button text="Actualizar resumen" onAction="#actualizar" styleClass="primary"/><Button text="Probar conexión" onAction="#probarConexion"/></HBox>
  <Label fx:id="estado" wrapText="true" styleClass="status" maxWidth="Infinity"/>
 </VBox></center>
</BorderPane>

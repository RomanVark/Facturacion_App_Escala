<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="ni.edu.uam.facturacionapp.Controller.ClienteController" prefWidth="1100" prefHeight="800" spacing="16" styleClass="page" stylesheets="@styles.css">
 <HBox alignment="CENTER_LEFT" spacing="16"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="CATÁLOGOS / CLIENTES" styleClass="eyebrow"/><Label text="Clientes" styleClass="title"/></VBox><Button text="Actualizar tabla" onAction="#recargar"/></HBox>
 <Label text="Crea un registro o selecciona una fila para editarlo. Los campos con * son obligatorios." styleClass="muted" wrapText="true"/>
 <VBox spacing="16" styleClass="card"><Label text="Datos del registro" styleClass="card-title"/>
 <GridPane hgap="20" vgap="14"><columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints><VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="1"><Label text="Nombre *"/><TextField fx:id="nombre" maxWidth="Infinity" /></VBox><VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="1"><Label text="Documento *"/><TextField fx:id="documento" maxWidth="Infinity" /></VBox><VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.columnSpan="1"><Label text="Teléfono"/><TextField fx:id="telefono" maxWidth="Infinity" /></VBox><VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="1"><Label text="Correo"/><TextField fx:id="correo" maxWidth="Infinity" /></VBox><VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="1"><Label text="Dirección"/><TextField fx:id="direccion" maxWidth="Infinity" /></VBox><CheckBox fx:id="activo" text="Cliente activo" GridPane.columnIndex="2" GridPane.rowIndex="1"/></GridPane>
 <HBox spacing="10"><Button text="Guardar nuevo" onAction="#guardar" styleClass="primary"/><Button text="Actualizar seleccionado" onAction="#actualizarSeleccionado"/><Button text="Nuevo / Limpiar" onAction="#nuevo"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="eliminarBoton" text="Eliminar seleccionado" onAction="#eliminar" styleClass="danger"/></HBox>
 </VBox>
 <TextField fx:id="filtro" promptText="Buscar en clientes…"/>
 <TableView fx:id="tabla" VBox.vgrow="ALWAYS" prefHeight="290"><columns><TableColumn text="ID" prefWidth="50"/><TableColumn text="Nombre" prefWidth="180"/><TableColumn text="Documento" prefWidth="130"/><TableColumn text="Teléfono" prefWidth="110"/><TableColumn text="Correo" prefWidth="180"/><TableColumn text="Dirección" prefWidth="160"/><TableColumn text="Estado" prefWidth="85"/></columns></TableView>
 <Label fx:id="estado" wrapText="true" styleClass="status" maxWidth="Infinity"/>
</VBox>
